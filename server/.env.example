# Ключи VAPID: npm run keys (один раз; публичный ключ — в studio.push.vapidPublicKey на сайте)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт для почтовых служб пуша (Google, Apple, Mozilla)
VAPID_SUBJECT=mailto:admin@example.ru
PORT=8787
# Сайты, которым можно обращаться к серверу, через запятую; * — любой поддомен
ALLOWED_ORIGINS=https://*.zapisvonline.ru,http://localhost:5190
DATA_FILE=./data/db.json
